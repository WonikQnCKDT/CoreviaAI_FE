# 이 파일을 .env로 복사해서 값을 채웁니다. (.env는 git에 올리지 않습니다)
# VITE_로 시작하는 값은 빌드할 때 화면 코드에 그대로 들어가므로 비밀값을 넣지 않습니다.

# 인증 방식: api = 실제 인증 서버, demo = 데모 로그인(기본값)
VITE_AUTH_MODE=demo

# 브라우저가 호출할 API 기본 주소. 개발 서버 프록시를 쓰면 /api 그대로 둡니다.
VITE_API_URL=/api

# (개발 서버 전용) /api 요청을 넘길 백엔드 주소. 비워 두면 프록시를 쓰지 않습니다.
# 같은 출처로 맞춰야 HttpOnly 쿠키(RefreshToken Path=/api/auth)가 그대로 동작합니다.
VITE_API_PROXY_TARGET=http://localhost:8080
